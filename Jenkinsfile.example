// Ejemplo 1: Utilizar la etiqueta preconfigurada en Jenkins (Manage Jenkins -> Clouds -> Kubernetes)
pipeline {
    agent {
        label 'k8s-agent'
    }
    stages {
        stage('Hola Kubernetes') {
            steps {
                sh 'echo "Ejecutando en un Pod dinámico y efímero en Minikube!"'
                sh 'uname -a'
            }
        }
    }
}

